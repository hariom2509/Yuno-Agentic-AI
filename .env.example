# LLM Provider — at least one is required
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM Base URL — set to Groq to use Llama 3 models (default), or OpenAI endpoint
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Database — defaults to local SQLite if not set
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yuno_ai

# Redis — defaults to in-memory fallback if not set
REDIS_URL=redis://localhost:6379/0

# Integrations — optional
GITHUB_PERSONAL_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
